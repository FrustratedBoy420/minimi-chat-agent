# Copy this file to .env and fill in your own keys. Never commit .env.

# --- Model providers (free tiers). At least one is required. ---
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (optional fallback): https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter (optional last-resort fallback): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model chains: "provider:model-id" in order of preference. The first one that works is used.
# Free-tier model lists change; check each provider's current model list if a call fails with 404.
LLM_MAIN_CHAIN=google:gemini-3.5-flash-lite,google:gemini-3.1-flash-lite,google:gemini-3.6-flash,groq:openai/gpt-oss-120b,openrouter:openrouter/free
LLM_FAST_CHAIN=google:gemini-3.5-flash-lite,google:gemini-3.1-flash-lite,google:gemini-3.6-flash,groq:openai/gpt-oss-20b,openrouter:openrouter/free

# Free-tier requests per day per model ("provider:model=N" or "provider:*=N"). A model at 90% of its limit
# is moved to the back of the chain. Defaults are conservative; check your provider's current limits.
# LLM_DAILY_LIMITS=google:gemini-3.5-flash-lite=450,google:gemini-3.1-flash-lite=450,google:gemini-3.6-flash=18,groq:*=900,openrouter:*=45

# Prompt size budgets in characters (~4 chars per token). Smaller = faster and friendlier to free-tier limits.
# PROMPT_RECALL_CHARS=9000
# PROMPT_SOURCE_CHARS=20000
# PROMPT_TOOL_RESULT_CHARS=1000

# --- Web search (required) ---
# Tavily free plan (1,000 credits/month): https://app.tavily.com
TAVILY_API_KEY=
# SEARCH_MAX_PER_TURN=5
# SEARCH_MAX_PER_CHANGE_CHECK=10
# SEARCH_MAX_PER_DAY=40

# --- Optional ---
# Freeze "now" for reproducible date tests, e.g. 2026-11-11T12:00:00+05:30
AGENT_NOW=
# Where the local database is stored
DATA_DIR=./data
